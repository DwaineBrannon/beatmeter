rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars: readable by anyone, writable only by the owner, image types only, max 5 MB
    match /users/{userId}/avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024 // 5 MB
        && request.resource.contentType.matches('image/.*');
    }

    // User header images: readable by anyone, writable only by the owner, image types only, max 8 MB
    match /users/{userId}/headers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
  && request.resource.size < 8 * 1024 * 1024 // 8 MB
  && request.resource.contentType.matches('image/.*');
    }

    // Keep a safe default deny for anything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
