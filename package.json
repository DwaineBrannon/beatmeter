{
  "name": "beatmeterweb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run emulator\" \"npm run client\"",
    "emulator": "firebase emulators:start",
    "client": "cd client && npm run dev",
    "install:client": "cd client && npm ci",
    "build:local": "npm run install:client && cd client && npm run build",
    "build": "echo 'Build handled by apphosting.yaml'",
    "deploy": "npm run build:local && firebase deploy",
    "serve": "firebase serve --only hosting",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:all": "concurrently \"npm run dev --prefix client\" \"firebase emulators:start\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "firebase-tools": "^13.31.0"
  },
  "dependencies": {
    "firebase-functions": "^6.3.2"
  }
}
